 logger = get_logger(__name__)

+PUNCTUATION_RE = re.compile(r"[^\w']+")
+
+
+def _merge_punctuation(text: str, words: List[dict]) -> List[dict]:
+    if not words or not text:
+        return words
+    result: List[dict] = []
+    tokens = text.split()
+    wi = 0
+    for token in tokens:
+        if wi >= len(words):
+            break
+        clean_token = PUNCTUATION_RE.sub("", token)
+        clean_word = PUNCTUATION_RE.sub("", words[wi]["word"])
+        if clean_token.lower() == clean_word.lower():
+            result.append({
+                "word": token,
+                "start": words[wi]["start"],
+                "end": words[wi]["end"],
+                "score": words[wi]["score"],
+            })
+            wi += 1
+    while wi < len(words):
+        result.append(words[wi])
+        wi += 1
+    return result
+
