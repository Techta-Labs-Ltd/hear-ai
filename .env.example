ENVIRONMENT=production
HEAR_RUNTIME_MODE=production
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
HEAR_ENABLE_DOCS=false
HEAR_WORKER_ROLE=pipeline
HEAR_WORKER_ID=hear-worker-1
HEAR_WORKER_GENERATION=
HEAR_IMAGE_REVISION=replace-with-image-revision
HEAR_ENGINE_REVISION=replace-with-engine-revision
HEAR_MODEL_ROOT=/models
# Optional per-model weight directories keyed by manifest logical name, e.g.
# {"qwen3-asr-1.7b": "/models/custom-asr"}. Fish uses FISH_SPEECH_MODEL_ROOT.
HEAR_MODEL_PATHS_JSON=
# HEAR_MAGIC_CLEAN_MODEL_DIR=/models/magic-clean/DeepFilterNet3
HEAR_MODEL_FEATURES=
HEAR_TEMP_DIR=/audio
HEAR_MIN_FREE_SCRATCH_BYTES=1073741824
HEAR_BACKEND_INTERNAL_URL=https://api.hear.media/api/v1
HEAR_BACKEND_SERVICE_KEY=replace-me
HEAR_POD_API_KEY=replace-with-a-random-service-token
HEAR_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
HEAR_POD_MAX_CONCURRENT_JOBS=1
HEAR_POD_STACK_ROLES=pipeline,magic_clean_natural
# Import HEAR_BACKEND_POLICY_JSON or HEAR_BACKEND_REGISTRY_JSON from the owning
# backend deployment. It must match its ID, callback base, bucket and CDN scope.
# Reconstruction requires an approved image and explicit role/capacity settings.
HEAR_HOST_JOB_LOCK_PATH=/tmp/hear-ai/host-job.lock
HEAR_API_MAX_BODY_BYTES=2097152
HEAR_MAGIC_CLEAN_MODEL_DEVICE=cuda:0
AUDIO_DOWNLOAD_MAX_BYTES=4294967296
AUDIO_DOWNLOAD_READ_TIMEOUT_SECONDS=60
AUDIO_DECODE_TIMEOUT_SECONDS=1200
WHISPER_BATCH_SIZE=36
WHISPER_CHUNK_SECONDS=600
WHISPER_LONG_AUDIO_BATCH_SIZE=4
WHISPER_VAD_ONSET=0.65
WHISPER_VAD_OFFSET=0.50
WHISPER_MIN_AVG_LOGPROB=-0.75
QWEN_ASR_DTYPE=bfloat16
QWEN_ASR_DEVICE_MAP=cuda:0
DISCOVERY_MAX_NEW_TOKENS=1100
DISCOVERY_MAX_SEARCH_PHRASES=12
DISCOVERY_METADATA_ENABLED=true
QWEN_LLM_GPU_MEMORY_GIB=8.5
FISH_SPEECH_HOME=/opt/fish-speech
MAGIC_CLEAN_SCRATCH_BYTES=34359738368
RECONSTRUCTION_SCRATCH_BYTES=34359738368
RECONSTRUCTION_MAX_SOURCE_SECONDS=14400
MAGIC_CLEAN_MAX_INPUT_BYTES=4294967296
MAGIC_CLEAN_MAX_FRAMES=691200000
XDG_CACHE_HOME=/cache
HF_HOME=/cache/huggingface
HF_HUB_CACHE=/cache/huggingface/hub
TORCH_HOME=/cache/torch
UV_CACHE_DIR=/cache/uv

# Optional Sound Cleanup; uncomment only after provisioning immutable bundles.
# HEAR_SOUND_CLEANUP_BUNDLE=/models/sound-cleanup-v1-runtime
# HEAR_SOUND_CLEANUP_BUNDLE_SHA256=<manifest-sha256>
# HEAR_SOUND_CLEANUP_SEPARATOR_BUNDLE=/models/sound-cleanup-specialist/runtime
# HEAR_SOUND_CLEANUP_SEPARATOR_SHA256=<manifest-sha256>
