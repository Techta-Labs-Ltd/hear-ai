ENVIRONMENT=production
RAY_ADDRESS=local
RAY_DASHBOARD_HOST=0.0.0.0
RAY_DASHBOARD_PORT=8282
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
GRPC_PORT=50051
WHISPER_BATCH_SIZE=36
WHISPER_CHUNK_SECONDS=600
WHISPER_LONG_AUDIO_BATCH_SIZE=4
WHISPER_VAD_ONSET=0.65
WHISPER_VAD_OFFSET=0.50
WHISPER_MIN_AVG_LOGPROB=-0.75
QWEN_ASR_DTYPE=bfloat16
QWEN_ASR_DEVICE_MAP=cuda:0
GRPC_APPLICATION_NAME=hear
LOG_LEVEL=INFO
ORCHESTRATOR_MAX_CONCURRENT_JOBS=8
ORCHESTRATOR_MAX_CONCURRENT_JOBS_PER_USER=3
MAGIC_CLEAN_REPLICA_COUNT=1
MAGIC_CLEAN_ENGINE_REVISION=safe-v1
MAGIC_CLEAN_MP3_BITRATE_KBPS=96
MAGIC_CLEAN_CLEANUP_GRACE_SECONDS=1800
MAGIC_CLEAN_STORAGE_CREDENTIAL_MIN_TTL_SECONDS=86400
ORCHESTRATOR_JOB_TYPE_LIMITS={"pipeline":4,"transcription":4,"audio_tag":6,"categorization":6,"magic_clean":1,"rebuild":2,"reconstruction":1,"discovery":4}
ORCHESTRATOR_RECOVERY_SECONDS=15
GATEWAY_REPLICA_COUNT=2

BACKEND_REGISTRY_JSON={"local":{"service_key_sha256":"replace-with-64-char-sha256","allowed_endpoint_urls":["https://s3.example.com"],"allowed_buckets":["local-bucket"],"allowed_public_base_urls":["https://cdn.example.com/media"]}}
STORAGE_CONTEXT_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_URL=postgresql+psycopg2://user:password@database:5432/hear

MODEL_CACHE_DIR=/models
AUDIO_DOWNLOAD_MAX_BYTES=4294967296
AUDIO_DOWNLOAD_READ_TIMEOUT_SECONDS=60
AUDIO_DECODE_TIMEOUT_SECONDS=1200
HEAR_TEMP_DIR=/audio
AUDIO_CLEANUP_INTERVAL_SECONDS=300
AUDIO_MAX_AGE_SECONDS=86400
XDG_CACHE_HOME=/cache
HF_HOME=/cache/huggingface
HF_HUB_CACHE=/cache/huggingface/hub
TRANSFORMERS_CACHE=/cache/huggingface/transformers
TORCH_HOME=/cache/torch
UV_CACHE_DIR=/cache/uv
QWEN_ASR_MODEL_PATH=/models/qwen3-asr-1.7b
ALIGNER_MODEL_PATH=/models/qwen3-forced-aligner
LLM_MODEL_PATH=/models/qwen2.5-7b-instruct
TOXIC_MODEL_PATH=/models/toxic-bert
SENTIMENT_MODEL_PATH=/models/twitter-roberta-sentiment
NLI_MODEL_PATH=/models/nli-distilroberta
MOSSFORMER_MODEL_PATH=/models/mossformer2-se-48k
DEMUCS_MODEL=htdemucs
DEMUCS_MODEL_PATH=/models/demucs
FISH_SPEECH_HOME=/fish-speech
FISH_SPEECH_CHECKPOINT_PATH=/models/fish-speech/s2-pro
FISH_SPEECH_CODEC_PATH=/models/fish-speech/s2-pro/codec.pth
FISH_SPEECH_BNB_MODE=nf4
