ENVIRONMENT=production
RAY_ADDRESS=local
RAY_DASHBOARD_HOST=0.0.0.0
RAY_DASHBOARD_PORT=8324
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
GRPC_PORT=50051
WHISPER_BATCH_SIZE=36
WHISPER_CHUNK_SECONDS=600
WHISPER_LONG_AUDIO_BATCH_SIZE=4
WHISPER_VAD_ONSET=0.65
WHISPER_VAD_OFFSET=0.50
WHISPER_MIN_AVG_LOGPROB=-0.75
QWEN_ASR_DTYPE=bfloat16
QWEN_ASR_DEVICE_MAP=cuda:0
GRPC_APPLICATION_NAME=hear
LOG_LEVEL=INFO
ORCHESTRATOR_MAX_CONCURRENT_JOBS=3
ORCHESTRATOR_MAX_CONCURRENT_JOBS_PER_USER=1
MAGIC_CLEAN_REPLICA_COUNT=1
ORCHESTRATOR_JOB_TYPE_LIMITS={"pipeline":2,"transcription":2,"audio_tag":3,"categorization":3,"magic_clean":2,"rebuild":1,"reconstruct":1,"edit_transcript":1,"discovery":2}
ORCHESTRATOR_RECOVERY_SECONDS=15
GATEWAY_REPLICA_COUNT=2

BACKEND_REGISTRY_JSON={"backend-a":{"service_key_sha256":"replace-with-64-char-sha256","allowed_endpoint_urls":["https://s3.example.com"],"allowed_buckets":["backend-a-bucket"],"allowed_public_base_urls":["https://cdn-a.example.com/media"]},"backend-b":{"service_key_sha256":"replace-with-64-char-sha256","allowed_endpoint_urls":["https://s3.example.com"],"allowed_buckets":["backend-b-bucket"],"allowed_public_base_urls":["https://cdn-b.example.com/media"]}}
STORAGE_CONTEXT_ENCRYPTION_KEY=replace-with-fernet-key
DATABASE_URL=postgresql+psycopg2://user:password@database:5432/hear

MODEL_CACHE_DIR=/opt/ml/models
HEAR_TEMP_DIR=/workspace/hear-ai/audio
AUDIO_CLEANUP_INTERVAL_SECONDS=300
AUDIO_MAX_AGE_SECONDS=86400
TRAINING_CHECKPOINT_DIR=/var/lib/hear-ai/checkpoints
QWEN_ASR_MODEL_PATH=/opt/ml/models/qwen3-asr-1.7b
ALIGNER_MODEL_PATH=/opt/ml/models/qwen3-forced-aligner
LLM_MODEL_PATH=/opt/ml/models/qwen2.5-7b-instruct
TOXIC_MODEL_PATH=/opt/ml/models/toxic-bert
SENTIMENT_MODEL_PATH=/opt/ml/models/twitter-roberta-sentiment
NLI_MODEL_PATH=/opt/ml/models/nli-distilroberta
MOSSFORMER_MODEL_PATH=/opt/ml/models/mossformer2-se-48k
DEMUCS_MODEL=htdemucs
FISH_SPEECH_HOME=/opt/fish-speech
FISH_SPEECH_CHECKPOINT_PATH=/opt/ml/models/fish-speech/s2-pro
FISH_SPEECH_BNB_MODE=nf4
