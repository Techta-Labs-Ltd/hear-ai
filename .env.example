# =============================================================================
# Hear AI — environment variables (copy to .env and adjust for your environment)
# =============================================================================
# start.sh runs: set -a; . .env; set +a
# Any value with spaces or shell metacharacters MUST be in "double quotes".
# Pydantic loads the same file at runtime; bash sourcing still requires quotes
# for multi-word lines.
# =============================================================================

# --- Auth & public HTTP (required) ---
AI_SERVICE_SECRET=8c361a305f40bfc53b165b41c274b00fdba004445e8473bc0e04da8d0093aca4
HEAR_BACKEND_URL=https://internal.hear.surf
HEAR_CALLBACK_URL=https://internal.hear.surf/api/v1/internal/ai-callback

# --- PostgreSQL (required) ---
# Copy this file to .env, then set DATABASE_URL to your real server (RunPod peer, RDS, Docker service name, 127.0.0.1, etc.).
# Template (do not leave db.example.com or the word HOST as the hostname — they are not your database):
#   postgresql+psycopg2://USER:PASSWORD@your-db-hostname:5432/hear_ai?sslmode=require
# Port must be numeric (5432). Never use the literal substring :PORT (old docs typo).
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_STATEMENT_TIMEOUT_MS=60000

# --- Local temp audio ---
HEAR_TMP_DIR=
HEAR_TEMP_RETENTION_SECONDS=172800
HEAR_TEMP_SWEEP_INTERVAL_SECONDS=3600

# --- Backblaze B2 (S3-compatible uploads) ---
B2_KEY_ID=0058fd708f216270000000001
B2_APPLICATION_KEY=K0052yJLs2inzSi0aMnD5Cioewme8xo
B2_BUCKET_NAME=hear-dev-uploads
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_ENHANCED_PREFIX=enhanced/
B2_PIPELINE_MP3_PREFIX=pipeline-source-mp3/

# --- Data files (paths relative to app working directory) ---
CATEGORIES_FILE=./data/categories.txt
HARM_KEYWORDS_FILE=./data/harm_keywords.txt

# --- ML model cache & Demucs ---
MODEL_CACHE_DIR=/opt/ml/models
DEMUCS_MODEL=htdemucs

# --- Whisper (Faster-Whisper) ---
WHISPER_MODEL_SIZE=distil-large-v3
WHISPER_DUAL_PASS=false
WHISPER_BEAM_SIZE=1
WHISPER_WORD_TIMESTAMPS=true

# --- Qwen LLM (optional; moderation/categorization use it when enabled) ---
QWEN_LLM_ENABLED=true

# --- Worker concurrency ---
MAX_CONCURRENT_GPU_JOBS=5
MAX_CONCURRENT_JOBS=5
MAX_CONCURRENT_PIPELINE_JOBS=8
MAX_CONCURRENT_MAGIC_CLEAN_JOBS=1
JOB_MAX_RETRIES=8
CALLBACK_RETRY_POLL_SECONDS=45

# --- OpenAI (optional categorization / LLM paths) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Moderation ---
MODERATION_AUTO_LEARN=false

# --- Higgs / rebuild audio (optional) ---
HIGGS_AUDIO_ENABLED=true
HIGGS_AUDIO_MODULE=boson_multimodal
HIGGS_AUDIO_REPO_DIR=/workspace/higgs-audio
HIGGS_AUDIO_VOICE=en_us_001
HIGGS_AUDIO_MODEL_PATH=bosonai/higgs-audio-v2-generation-3B-base
HIGGS_AUDIO_TOKENIZER_PATH=bosonai/higgs-audio-v2-tokenizer
HIGGS_AUDIO_SYSTEM_PROMPT="Generate audio following instruction."

# --- Sentry ---
SENTRY_DSN=https://524e4bd869b9cba077fab7320f9d8abd@o4511076317855744.ingest.de.sentry.io/4511226435731536
SENTRY_TRACES_SAMPLE_RATE=0.3

# --- App meta ---
ENVIRONMENT=production
ENABLE_DOCS=true

# =============================================================================
# Optional — not read by app.config Settings (scripts / local tooling only)
# =============================================================================
# AI_SERVICE_URL=http://127.0.0.1:8000
# Used by tests/test_api.py when set; defaults to http://localhost:8000 in code.
